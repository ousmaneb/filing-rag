# EDGAR rejects requests without a descriptive User-Agent: "Name email@example.com"
SEC_USER_AGENT=
ANTHROPIC_API_KEY=
SECRAG_GENERATION_MODEL=claude-opus-5
SECRAG_JUDGE_MODEL=claude-sonnet-5
QDRANT_URL=http://localhost:6333

# API access. Leave SECRAG_API_KEY empty for an open public demo; set it (long and random,
# e.g. `openssl rand -hex 32`) to require it on /ask and /search via X-API-Key or Bearer.
SECRAG_API_KEY=
# Reverse proxies in front of the API that append to X-Forwarded-For (0 = none, use the
# socket address). Set to 1 behind a single proxy such as Railway, Fly or nginx.
SECRAG_TRUST_PROXY_HOPS=0
# Rate limits (0 disables one). The global /ask cap protects the Anthropic budget.
SECRAG_ASKS_PER_HOUR=60
SECRAG_ASKS_PER_IP_PER_HOUR=10
SECRAG_SEARCHES_PER_IP_PER_MINUTE=20
